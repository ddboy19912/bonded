---
import Hero from "../components/Hero.astro";
import PostList from "../components/PostList.astro";
import Base from "../layouts/Base.astro";
import { paginate } from "../lib/paginate.mjs";
import { indexPosts } from "../lib/sanity";

const [page] = paginate(await indexPosts());
---

<Base
  title="Blog | Bonded"
  description="Notes from Bonded on red-teaming AI agents, safety scores, and paying people back when an agent breaks its rules."
>
  <Hero />

  <PostList page={page} />
</Base>
