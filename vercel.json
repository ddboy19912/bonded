{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm turbo run build --filter @bonded/web...",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/.well-known/bonded-agent-keys.json",
      "destination": "https://api-production-ba50.up.railway.app/.well-known/bonded-agent-keys.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
