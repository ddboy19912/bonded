{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm turbo run build --filter @bonded/web...",
  "outputDirectory": "apps/web/dist",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "app.bondedhq.xyz"
        }
      ],
      "destination": "/overview",
      "permanent": false
    },
    {
      "source": "/((?:privacy|blog)(?:/.*)?)",
      "has": [
        {
          "type": "host",
          "value": "app.bondedhq.xyz"
        }
      ],
      "destination": "https://www.bondedhq.xyz/$1",
      "permanent": true
    },
    {
      "source": "/((?:overview|arena|attacks|sentinel|agents|vaults|underwrite|claims|leaderboard|index|bounties|status|inbox|gate|shared)(?:/.*)?)",
      "has": [
        {
          "type": "host",
          "value": "www.bondedhq.xyz"
        }
      ],
      "destination": "https://app.bondedhq.xyz/$1",
      "permanent": true
    },
    {
      "source": "/docs",
      "destination": "https://docs.bondedhq.xyz/",
      "permanent": true
    },
    {
      "source": "/docs/(.*)",
      "destination": "https://docs.bondedhq.xyz/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/bonded-agent-keys.json",
      "destination": "https://api-production-ba50.up.railway.app/.well-known/bonded-agent-keys.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
