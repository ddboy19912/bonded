---
import { getImage, Image } from "astro:assets";
import { render } from "astro:content";
import PostCard from "../components/PostCard.astro";
import Base from "../layouts/Base.astro";
import { formatDate, publishedPosts, readingTime, type Post } from "../posts";

export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const all = await publishedPosts();
const { Content } = await render(post);
const base = import.meta.env.BASE_URL;
// Covers are 1600x840, so 1200 wide is exactly the 1200x630 link-preview size.
const og = await getImage({ src: post.data.cover, width: 1200, format: "jpg" });
const ogImage = new URL(og.src, Astro.site).href;
const more = all.filter((p) => p.id !== post.id).slice(0, 2);
---

<Base
  title={`${post.data.title} | Bonded`}
  description={post.data.description}
  type="article"
  published={post.data.date}
  ogImage={ogImage}
  ogImageAlt={post.data.coverAlt}
>
  <article class="post">
    <header class="post-header">
      <a class="back" href={base}><span aria-hidden="true">←</span> All posts</a>
      <div class="tags">{post.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
      <h1>{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
      <p class="byline">
        {post.data.author} · {formatDate(post.data.date)} · {readingTime(post.body)} min read
      </p>
    </header>

    <figure class="cover">
      <Image
        src={post.data.cover}
        alt={post.data.coverAlt}
        widths={[800, 1200, 1600]}
        sizes="(max-width: 1000px) 100vw, 960px"
        loading="eager"
      />
    </figure>

    <div class="prose">
      <Content />
    </div>

    <aside class="cta">
      <div>
        <h2>Is your agent ready?</h2>
        <p>Test it free against the red team. Any framework, with only a wallet sign-in.</p>
      </div>
      <a class="btn btn-brand" href="/agents/test">Test your agent <span aria-hidden="true">→</span></a>
    </aside>
  </article>

  {
    more.length > 0 && (
      <section class="more">
        <h2>More from the blog</h2>
        <div class="grid">
          {more.map((p) => (
            <PostCard post={p} />
          ))}
        </div>
      </section>
    )
  }
</Base>
